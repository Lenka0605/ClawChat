#!/usr/bin/env node
// 假 Antigravity CLI：只写测试数据，校验订阅计费开关，不连接任何模型。
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import crypto from 'node:crypto';

if (process.argv.includes('--version')) { process.stdout.write('1.4.10-fake\n'); process.exit(0); }
// 程序列表里的「更新」会跑 agy update；不联网，直接说已是最新
if (process.argv[2] === 'update') { process.stdout.write('Already up to date (1.4.10-fake)\n'); process.exit(0); }
// 检测程序时会跑 agy models 问账号能用哪些模型（每行「编号<Tab>显示名」）；FAKE_AGY_MODELS 可以换成别的列表测
if (process.argv[2] === 'models') {
  process.stdout.write('Fetching available models...\n');
  process.stdout.write(process.env.FAKE_AGY_MODELS || 'gemini-3.8-flash-high\tGemini 3.8 Flash (High)\ngemini-3.8-flash-medium\tGemini 3.8 Flash (Medium)\ngemini-3.8-flash-low\tGemini 3.8 Flash (Low)\n');
  process.exit(0);
}
if (process.argv.includes('-p') && process.argv.includes('/usage')) {
  if (process.env.GEMINI_API_KEY || process.env.GOOGLE_API_KEY) {
    process.stderr.write('订阅查询不能带 API Key\n');
    process.exit(2);
  }
  if (process.env.FAKE_AGY_USAGE) {
    process.stdout.write(process.env.FAKE_AGY_USAGE);
  } else {
    const future = (ms) => new Date(Date.now() + ms).toISOString();
    process.stdout.write(JSON.stringify({
      conversation_id: '',
      status: 'SUCCESS',
      command: {
        name: 'usage',
        data: {
          groups: [
            { name: 'Gemini Models', buckets: [
              { id: 'gemini-weekly', window: 'weekly', remaining_fraction: 0.89, reset_time: future(5 * 86400000) },
              { id: 'gemini-5h', window: '5h', remaining_fraction: 0.78, reset_time: future(3 * 3600000) },
            ] },
            { name: 'Claude and GPT models', buckets: [
              { id: '3p-weekly', window: 'weekly', remaining_fraction: 1, reset_time: future(7 * 86400000) },
              { id: '3p-5h', window: '5h', remaining_fraction: 1, reset_time: future(5 * 3600000) },
            ] },
            { name: 'Gemini 4 Argon', buckets: [
              { id: 'gemini-argon-wtu-weekly', window: 'weekly', remaining_fraction: 0.95, reset_time: future(6 * 86400000) },
            ] },
          ],
        },
      },
    }) + '\n');
  }
  process.exit(0);
}
const args = process.argv.slice(2);
const value = (flag) => args.includes(flag) ? args[args.indexOf(flag) + 1] : '';
const emit = (e) => process.stdout.write(`${JSON.stringify(e)}\n`);
const home = process.env.CLAWCHAT_HOME;
if (!home || path.resolve(home) === path.join(os.homedir(), '.clawchat') || path.resolve(home) === os.homedir()) {
  process.stderr.write('假 agy 必须使用独立的 CLAWCHAT_HOME\n'); process.exit(1);
}
const settings = JSON.parse(value('--settings') || '{}');
if (settings.useG1Credits !== false || settings.modelProvider !== '' || process.env.GEMINI_API_KEY || process.env.GOOGLE_API_KEY) {
  process.stderr.write('订阅测试必须禁止点数和 API 回退\n'); process.exit(1);
}
const dir = path.join(home, 'fake-agy');
fs.mkdirSync(dir, { recursive: true });
const sid = value('--conversation') || crypto.randomUUID();
if (!/^[\w-]+$/.test(sid)) process.exit(1);
const file = path.join(dir, `${sid}.json`);
let messages = [];
if (value('--conversation')) {
  try { messages = JSON.parse(fs.readFileSync(file, 'utf8')); }
  catch { process.stderr.write('找不到假 agy 的历史会话\n'); process.exit(1); }
}
// 和真 agy 一样：stdin 一行一条消息，每条跑一轮；stdin 关了、手上的都做完就退出（中途插话会在跑的时候再写一条）
emit({ event: 'init', conversation_id: sid, init: { model: value('--model') } });
const { createInterface } = await import('node:readline');
let n = 0;
for await (const raw of createInterface({ input: process.stdin })) {
  if (!raw.trim()) continue;
  const input = JSON.parse(raw);
  if (input.event !== 'user' || typeof input.message?.content !== 'string') process.exit(1);
  messages.push(input.message.content);
  emit({ event: 'step_update', step_update: { step_type: 'user_input', step_index: n++ } });
  await new Promise((resolve) => setTimeout(resolve, Math.max(0, Number(process.env.FAKE_SECS || 0.1)) * 1000));
  // 提示词里出现「分身答应要做的事现在去做」（分身已经替它回过话）时照做；群聊每轮结尾那句「没有要说的就只回 [PASS]」不在此列，照常回「做完了」
  const response = /分身答应要做的事现在去做/.test(input.message.content) ? '[PASS]' : messages.length > 1 && n > 1 ? '（假的 Gemini 订阅）收到插话' : '（假的 Gemini 订阅）做完了';
  fs.writeFileSync(file, JSON.stringify(messages), { mode: 0o600 });
  emit({ event: 'step_update', step_update: { step_type: 'agent_response', step_index: n++, state: 'DONE', text_delta: response, usage: { input_tokens: 100, output_tokens: 10 } } });
  emit({ event: 'result', result: { conversation_id: sid, status: 'SUCCESS', response, usage: { input_tokens: 100, output_tokens: 10, thinking_tokens: 0 } } });
}
